<odoo>
	<data>
		
     <record id="paperformat_sale_order_landscape" model="report.paperformat">
        <field name="name">PF Sale Order Portrait</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field> 
        <field name="page_height">103</field>
        <field name="page_width">66</field>
        <!-- <field name="orientation">Landscape</field> -->
        <field name="margin_top">7</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">12</field>
        <field name="dpi">90</field>
    </record>
    <report
		id="aroma_lot_report_id"
	    model="stock.production.lot"
	    string="Aroma Lot pdf"
	    report_type="qweb-pdf"
	    name="stock.aroma_lot_report"
	    file="stock.aroma_lot_report"
	    paperformat = "paperformat_sale_order_landscape"
		/>

	</data>
</odoo>