<?xml version="1.0" encoding="utf-8"?>
<odoo>
		<record id="xn_aroma_account_invoice_form" model="ir.ui.view">
				<field name="name">account.invoice.custom.form.inherited</field>
				<field name="model">account.move</field>
				<field name="inherit_id" ref="account.view_move_form"/>
				<field name="arch" type="xml">
					<field name = "partner_id" position = "after">
						<field name = "xn_contact_id" options="{'no_create':True}"/>
					</field>
					
					<xpath expr="//field[@name='team_id']" position="after">
						<field name="xn_insurance_id"/>
						<field name="xn_reference_no"/>
						<field name="xn_transportation_id"/>
					</xpath>
					
					<field name="name" position="replace"/>
					<field name="team_id" position="after" >
						<field name="name"/>
					</field>

					<field name="partner_shipping_id" position="attributes">
						<attribute name="string">Mark Address</attribute>
					</field>

<!--                	<xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='uom_id']" position="after">-->
<!--                        <field name="xn_package_id" />-->
<!--                    </xpath>		-->

<!--					<field name="comment" position="before" >-->
<!--						<field name="xn_description_of_goods" class="oe_inline" placeholder="Description of Goods"/>-->
<!--					</field>                    			-->


				</field>
		</record>	
</odoo>