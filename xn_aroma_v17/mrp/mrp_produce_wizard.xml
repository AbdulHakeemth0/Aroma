<?xml version="1.0" encoding="utf-8"?>
<odoo>
		<record id="xn_aroma_mrp_wizard_form" model="ir.ui.view">
			<field name="name">aroma mrp wizard form</field>
			<field name="model">mrp.product.produce</field>
			<field name="inherit_id" ref="mrp.view_mrp_product_produce_wizard"/>
			<field name="arch" type="xml">
				<xpath expr="//form/group[1]/group" position="inside">
					<button name="xn_update" type="object" string="Update"/>
				</xpath>

 				<field name = "lot_id" position ="replace" >
 					<field name="lot_id" attrs="{'invisible': [('product_tracking', '=', 'none')]}" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}"/>
 				</field>

			</field>
		</record>
</odoo>
